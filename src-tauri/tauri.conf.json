{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MangaFolio",
  "version": "0.1.4",
  "identifier": "com.racious.mangafolio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MangaFolio",
        "width": 1200,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGNDk4M0UxMjVDRjk0QTgKUldTb2xNOGw0WU5KcitFS2daZFExaFRjZ280anBJZFVEVktUWnhCNGUwS1N2UTg1MloyRzM5VTAK",
      "endpoints": [
        "https://github.com/Racious/MangaFolio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
